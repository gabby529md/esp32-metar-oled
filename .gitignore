# =============================================================
#  .gitignore for ESP32 Arduino project
#  Base: GitHub C++ template (github.com/github/gitignore)
#  Extended: Arduino IDE 2.x + ESP32 toolchain artefacts
# =============================================================

# -----------------------------------------------
#  C++ compiled object and build output
#  (from GitHub's official C++.gitignore template)
# -----------------------------------------------
*.d
*.o
*.obj
*.ko
*.elf
*.ilk
*.map
*.exp
*.gch
*.pch
*.lib
*.a
*.la
*.lo
*.dll
*.so
*.so.*
*.dylib
*.exe
*.out
*.app

# -----------------------------------------------
#  Arduino IDE 1.x build output
# -----------------------------------------------
build/
*.bin
*.hex
*.eep

# -----------------------------------------------
#  Arduino IDE 2.x cache and temp folders
#  Default sketch cache: ~/Arduino/
#  IDE config:           ~/.arduino15/
# -----------------------------------------------
.arduino15/
arduino-cli.yaml

# Sketch build cache (created alongside .ino in IDE 2.x)
*.ino.bin
*.ino.elf
*.ino.hex
*.ino.map
*.ino.with_bootloader.bin

# -----------------------------------------------
#  ESP32 toolchain folders (if cloned locally)
#  Mirrors Espressif's own arduino-esp32 .gitignore
# -----------------------------------------------
tools/esp32-arduino-libs
tools/xtensa-esp-elf
tools/xtensa-esp32-elf
tools/xtensa-esp32s2-elf
tools/xtensa-esp32s3-elf
tools/xtensa-esp-elf-gdb
tools/riscv32-esp-elf
tools/riscv32-esp-elf-gdb
tools/dist
tools/esptool
tools/esptool.exe
tools/mkspiffs
tools/mklittlefs
tools/openocd-esp32

# -----------------------------------------------
#  Secrets — NEVER commit WiFi credentials or
#  API keys. Sketch uses placeholder strings.
# -----------------------------------------------
secrets.h
config_local.h
credentials.h
wifi_config.h

# -----------------------------------------------
#  IDEs and editors
# -----------------------------------------------

# VS Code
.vscode/
*.code-workspace

# Visual Studio / VisualMicro (Arduino plugin)
[Dd]ebug/
[Rr]elease/
.vs/
__vm/
*.vcxproj*
platform.sloeber.txt
boards.sloeber.txt

# JetBrains (CLion)
.idea/
cmake-build-*/

# Sublime Text
*.sublime-workspace

# Vim / Neovim swap files
.*.swp
.*.swo
*~

# -----------------------------------------------
#  Operating system files
# -----------------------------------------------

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~

# -----------------------------------------------
#  Logs and debug artefacts
# -----------------------------------------------
*.log
debug.cfg
debug.svd
debug_custom.json

# -----------------------------------------------
#  Python (build tooling / scripts)
# -----------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.env
venv/
_build/

# -----------------------------------------------
#  Node (if a test runner or tooling is added)
# -----------------------------------------------
node_modules/
npm-debug.log
